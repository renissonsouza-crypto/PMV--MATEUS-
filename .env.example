DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional public contact channels; configure verified values before deployment.
# VITE_ variables are included in the frontend and must never contain secrets.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# Canonical HTTPS origin for Google login. Direct enrollment does not need email settings.
APP_BASE_URL=

# Google OAuth (server only). Create a Web application OAuth client in Google Cloud.
# Authorized JavaScript origin must be APP_BASE_URL (no path).
# Authorized redirect URI must be APP_BASE_URL + /api/auth?action=callback
# Local development: http://localhost:5173/api/auth?action=callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: set false to pause adaptive chat selection; reviewed answers still work.
# Each visitor must opt in inside the chat before sending anonymous ratings.
CHAT_LEARNING_ENABLED=true
