DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional public contact channels; configure verified values before deployment.
# VITE_ variables are included in the frontend and must never contain secrets.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# Transactional course confirmations (server only; never use VITE_ prefixes).
# Create a Resend account and verify the sending domain first.
RESEND_API_KEY=
MAIL_FROM=
# Canonical HTTPS origin of the deployed site, without path/query/fragment.
APP_BASE_URL=

# Google OAuth (server only). Create a Web application OAuth client in Google Cloud.
# Authorized redirect URI must be APP_BASE_URL + /api/auth?action=callback
# Local development: http://localhost:5173/api/auth?action=callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
